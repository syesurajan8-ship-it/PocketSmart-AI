# Google AI Studio / Gemini API key
# Get one from Google AI Studio and paste it here.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Optional: if your account does not expose the default model, the app tries fallbacks.
GEMINI_MODEL=gemini-3.8-flash

# Local app settings
FLASK_SECRET_KEY=replace-with-a-long-random-string
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# Only set this to 1 if you are debugging Gemini errors locally.
DEBUG_GEMINI=0
